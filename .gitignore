```gitignore
# Dependencies
node_modules/
.jest/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Build outputs
dist/
build/
out/
public/build/
*.bundle.js
*.chunk.js

# Testing
.jest/
coverage/

# TypeScript
*.tsbuildinfo
```